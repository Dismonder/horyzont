[layer_names]

3d_physics/layer_1="terrain"
3d_physics/layer_2="constructs"
3d_physics/layer_3="server_bodies"
3d_physics/layer_4="client_bodies"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.windows="vulkan"

[voxel]

; The C# wrapper of the VoxelBuffer handed to a stream callback holds one extra reference by design; Voxel Tools recommends turning this check off for C#.
ownership_checks=false
