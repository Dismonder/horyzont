<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <!-- A literal: the Godot editor rewrites a TargetFramework it cannot parse (such as $(HoryzontTargetFramework)) to net8.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Horyzont.Game</RootNamespace>
    <AssemblyName>Horyzont.Game</AssemblyName>
    <!-- IDE0005 in the build needs the documentation file; the game code itself does not need XML docs. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GodotFloat64>true</GodotFloat64>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../src/Horyzont.Core/Horyzont.Core.csproj" />
    <ProjectReference Include="../src/Horyzont.Persistence/Horyzont.Persistence.csproj" />
    <ProjectReference Include="../src/Horyzont.Net/Horyzont.Net.csproj" />
    <ProjectReference Include="../src/Horyzont.Constructs/Horyzont.Constructs.csproj" />
  </ItemGroup>
  <!-- Engine tests (game/tests) and their fixtures exist only in Debug; the export configurations ship neither. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="../tests/Horyzont.Testing/Horyzont.Testing.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="tests/**" />
  </ItemGroup>
</Project>
