<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <!-- A literal: the Godot editor rewrites a TargetFramework it cannot parse (such as $(HoryzontTargetFramework)) to net8.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Horyzont.Game</RootNamespace>
    <AssemblyName>Horyzont.Game</AssemblyName>
    <!-- IDE0005 in the build needs the documentation file; the game code itself does not need XML docs. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GodotFloat64>true</GodotFloat64>
  </PropertyGroup>
  <PropertyGroup>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <!-- Engine tests (K2-08) and their packages must not reach the game and server exports. -->
  <ItemGroup Condition="'$(Configuration)' != 'ExportDebug' And '$(Configuration)' != 'ExportRelease'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="gdUnit4.api" />
    <PackageReference Include="gdUnit4.test.adapter" />
    <PackageReference Include="gdUnit4.analyzers" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'ExportDebug' Or '$(Configuration)' == 'ExportRelease'">
    <Compile Remove="tests/**" />
    <Compile Remove="gdunit4_testadapter_v5/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../src/Horyzont.Core/Horyzont.Core.csproj" />
    <ProjectReference Include="../src/Horyzont.Persistence/Horyzont.Persistence.csproj" />
    <ProjectReference Include="../src/Horyzont.Net/Horyzont.Net.csproj" />
    <ProjectReference Include="../src/Horyzont.Server/Horyzont.Server.csproj" />
    <ProjectReference Include="../src/Horyzont.Client/Horyzont.Client.csproj" />
    <ProjectReference Include="../src/Horyzont.Constructs/Horyzont.Constructs.csproj" />
  </ItemGroup>
  <!-- Engine tests (game/tests) and their fixtures exist only in Debug; the export configurations ship neither. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="../tests/Horyzont.Testing/Horyzont.Testing.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="tests/**" />
  </ItemGroup>
</Project>
